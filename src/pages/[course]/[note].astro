---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  getCourses,
  getNotes,
  getNotesOfCourse,
  getNoteIndex,
  nextSteps,
  noteHref,
  noteSlug,
  courseHref,
  tagHref,
  typeLabels,
  levelLabels,
  statusLabels,
  lastUpdated,
  formatDate,
  quizCount,
  lessonIssues,
  url,
} from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { course: note.data.course, note: noteSlug(note) },
    props: { note },
  }));
}

const { note } = Astro.props;
const d = note.data;
const courses = await getCourses();
const course = courses.find((c) => c.id === d.course);
if (!course) {
  throw new Error(`Bài "${note.id}" khai báo course "${d.course}" nhưng không có file tương ứng trong src/content/courses/.`);
}
const chapter = course.data.chapters.find((c) => c.id === d.chapter);
if (d.chapter && !chapter) {
  console.warn(`[cảnh báo] ${note.id}: chapter "${d.chapter}" không có trong danh sách chương của môn "${course.id}".`);
}

// Kiểm tra chuẩn nội dung: đủ trắc nghiệm, bài tập có lời giải.
// Khi build bản xuất bản, vi phạm sẽ làm build lỗi để không đăng bài thiếu.
const issues = lessonIssues(note);
if (issues.length > 0) {
  const message = `Bài "${note.id}" chưa đạt chuẩn nội dung:\n- ${issues.join('\n- ')}`;
  if (import.meta.env.PROD) throw new Error(message);
  console.warn(`[cảnh báo] ${message}`);
}

const allNotes = await getNotes();
const index = await getNoteIndex();
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Chuyển danh sách khóa "course/slug" thành bài viết; cảnh báo khi trỏ sai.
const resolve = (keys: string[], field: string) =>
  keys.flatMap((k) => {
    const n = index.get(k);
    if (!n) {
      console.warn(`[cảnh báo] ${note.id}: ${field} "${k}" không trỏ tới bài nào (hoặc bài đó là private).`);
      return [];
    }
    return [n];
  });

const prerequisites = resolve(d.prerequisites, 'prerequisites');
const related = resolve(d.related, 'related');
const following = nextSteps(note, allNotes);

const siblings = await getNotesOfCourse(course);
const pos = siblings.findIndex((n) => n.id === note.id);
const prev = pos > 0 ? siblings[pos - 1] : undefined;
const next = pos >= 0 && pos < siblings.length - 1 ? siblings[pos + 1] : undefined;

const date = formatDate(lastUpdated(note));
const quiz = quizCount(note);
const hasRelated = prerequisites.length || following.length || related.length;
---

<Base title={d.title} description={d.summary}>
  <div class="article-layout">
    <article data-pagefind-body>
      <ol class="breadcrumb" data-pagefind-ignore>
        <li><a href={url('/')}>Trang chủ</a></li>
        <li><a href={courseHref(course)}>{course.data.short}</a></li>
        {chapter && <li>{chapter.title}</li>}
      </ol>

      <header class="article-head">
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <ul class="chips" data-pagefind-ignore>
          <li><span class="chip" data-kind={d.type}>{typeLabels[d.type]}</span></li>
          {d.duration && <li><span class="chip tag">Khoảng {d.duration} phút</span></li>}
          {quiz > 0 && <li><span class="chip" data-kind="quiz">{quiz} câu trắc nghiệm</span></li>}
          <li><span class="chip" data-level={d.level}>{levelLabels[d.level]}</span></li>
          <li><span class="chip" data-status={d.status}>{statusLabels[d.status]}</span></li>
          {d.tags.map((t) => <li><a class="chip tag" href={tagHref(t)}>#{t}</a></li>)}
        </ul>
      </header>

      {
        issues.length > 0 && (
          <div class="draft-banner" role="alert" data-pagefind-ignore>
            <strong>Bài chưa đạt chuẩn nội dung</strong> (khi build bản xuất bản, bài này sẽ báo lỗi):
            <ul style="margin:6px 0 0">
              {issues.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        )
      }
      {
        d.visibility === 'private' && (
          <p class="draft-banner" role="note" data-pagefind-ignore>
            Bài này đang để chế độ riêng tư: chỉ thấy khi chạy <code>npm run dev</code>, sẽ không có trong bản xuất bản.
          </p>
        )
      }
      {
        d.status === 'draft' && (
          <p class="draft-banner" role="note" data-pagefind-ignore>
            Đây là bản nháp, chưa được đối chiếu lại với tài liệu gốc. Hãy kiểm tra công thức và số liệu trước khi dùng.
          </p>
        )
      }

      {
        (d.source || d.lecturer || date) && (
          <dl class="meta-box" data-pagefind-ignore>
            {d.lecturer && (
              <>
                <dt>Giảng viên</dt>
                <dd>{d.lecturer}</dd>
              </>
            )}
            {(d.sourceTitle || d.source) && (
              <>
                <dt>Tài liệu gốc</dt>
                <dd>
                  {d.sourceTitle ?? ''}
                  {d.source && <> <code>{d.source}</code></>}
                </dd>
              </>
            )}
            {date && (
              <>
                <dt>Cập nhật</dt>
                <dd>{date}</dd>
              </>
            )}
          </dl>
        )
      }

      {
        d.keywords.length > 0 && (
          <aside class="keywords" aria-labelledby="keywords-title">
            <h2 id="keywords-title">Thuật ngữ trong bài</h2>
            <dl>
              {d.keywords.map((k) => (
                <>
                  <dt>{k.term}</dt>
                  <dd>{k.meaning}</dd>
                </>
              ))}
            </dl>
          </aside>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        hasRelated ? (
          <section class="related" aria-label="Bài liên quan" data-pagefind-ignore>
            {prerequisites.length > 0 && (
              <div>
                <h2>Nên học trước</h2>
                <ul>
                  {prerequisites.map((n) => (
                    <li><a href={noteHref(n)}>{n.data.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {following.length > 0 && (
              <div>
                <h2>Học tiếp</h2>
                <ul>
                  {following.map((n) => (
                    <li><a href={noteHref(n)}>{n.data.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {related.length > 0 && (
              <div>
                <h2>Xem thêm</h2>
                <ul>
                  {related.map((n) => (
                    <li><a href={noteHref(n)}>{n.data.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        ) : null
      }

      {
        (prev || next) && (
          <nav class="prev-next" aria-label="Bài trước và bài sau" data-pagefind-ignore>
            {prev && (
              <a class="prev" href={noteHref(prev)} rel="prev">
                <small>Bài trước</small>
                <span>{prev.data.title}</span>
              </a>
            )}
            {next && (
              <a class="next" href={noteHref(next)} rel="next">
                <small>Bài sau</small>
                <span>{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      toc.length > 1 && (
        <nav class="toc" aria-label="Mục lục">
          <h2>Trong bài này</h2>
          <ol>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
</Base>

<script>
  import '../../scripts/quiz.ts';
</script>
