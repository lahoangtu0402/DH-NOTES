{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "course": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "lesson",
        "exercises",
        "reading",
        "guide"
      ]
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "default": "beginner",
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "visibility": {
      "default": "public",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "duration": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "keywords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        },
        "required": [
          "term",
          "meaning"
        ]
      }
    },
    "source": {
      "type": "string"
    },
    "sourceTitle": {
      "type": "string"
    },
    "lecturer": {
      "type": "string"
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "default": 100,
      "type": "number"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "summary",
    "course",
    "type"
  ]
}